{
  "expo": {
    "name": "Kcal Coach",
    "slug": "kcal-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kcalcoach.dev"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C1410",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.kcalcoach.dev"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kcalcoach",
    "backgroundColor": "#0C1410",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kcal Coach uses the camera to recognise your plate. Photos are analysed on your phone and never uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kcal Coach reads a photo you choose so it can recognise the food. It stays on your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}